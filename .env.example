# Hermes GitHub Task Watcher V1
HERMES_GITHUB_REPO=dinhthangqt/chatgpt-web-mcp-hermes
HERMES_TASK_POLL_MS=60000
HERMES_WORKER_ID=HERMES-PC-01
HERMES_TASK_TIMEOUT_MS=1800000
HERMES_GH_COMMAND=gh
HERMES_GIT_COMMAND=git
HERMES_TASK_EXECUTION_ENABLED=false
# HERMES_REPO_DIR=C:\\path\\to\\chatgpt-web-mcp-hermes

# Optional browser override. Leave empty when auto-detection works.
# CHATGPT_WEB_CHROME=/absolute/path/to/chrome

# Upload roots are a path-delimited allowlist for local file uploads.
# Windows example: D:\\hermes\\deliveries;C:\\Users\\<user>\\Downloads
# CHATGPT_WEB_UPLOAD_ROOTS=/absolute/path/to/allowed/uploads

# Persistent bounded operation journal.
# CHATGPT_WEB_OPERATION_JOURNAL=/absolute/path/to/operation-journal.json
# CHATGPT_WEB_OPERATION_JOURNAL_MAX_ENTRIES=100
# CHATGPT_WEB_OPERATION_JOURNAL_MAX_TOMBSTONES=10000
# CHATGPT_WEB_OPERATION_JOURNAL_UNRESOLVED_RETENTION_MS=2592000000

# The defaults below preserve the original strict routing policy.
CHATGPT_WEB_DEFAULT_TIER=极高
CHATGPT_WEB_PRO_TIER=Pro
CHATGPT_WEB_PROBE_PROMPT=你是什么模型？
CHATGPT_WEB_PROBE_ACCEPT_ID=gpt-5.6-pro
CHATGPT_WEB_PROBE_FALLBACK_ID=gpt-5.5-mini
CHATGPT_WEB_PROBE_ACCEPT_PATTERN=gpt\s*[- ]?5[.．]6\s*[- ]?pro|5[.．]6\s*[- ]?pro
CHATGPT_WEB_PROBE_FALLBACK_PATTERN=gpt\s*[- ]?5[.．]5\s*[- ]?mini|5[.．]5\s*[- ]?mini
CHATGPT_WEB_PRO_RECHECK_AFTER_CLOSE_MS=10800000
